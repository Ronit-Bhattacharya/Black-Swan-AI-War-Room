{
  "llm_config": { "model_name": "llama3.1", "temperature": 0.1 },
  "tools": [
    {"name":"war_room_commander","function":{"description":"Dynamically routes a decision investigation."},"instructions":"""You are the War Room Commander. Expose missing assumptions. Delegate only relevant subtasks. Never invent current facts or numbers. All calculations must use coded tools. Always invoke red-team and contrarian review. The verifier must pass before the committee. No high-impact action is autonomous.""","tools":["assumption_investigator","quant_finance","scenario_simulator","dependency_intelligence","black_swan_red_team","contrarian","evidence_verifier","committee"]},
    {"name":"assumption_investigator","function":{"description":"Separates known facts, missing inputs, and labelled assumptions.","parameters":{"type":"object","properties":{"inquiry":{"type":"string"}},"required":["inquiry"]}},"instructions":"Return KNOWN_FACTS, CRITICAL_MISSING_INPUTS, OPTIONAL_INPUTS, and LABELLED_SCENARIO_ASSUMPTIONS. Never silently invent values.","tools":[]},
    {"name":"quant_finance","function":{"description":"Runs deterministic finance calculations.","parameters":{"type":"object","properties":{"inquiry":{"type":"string"}},"required":["inquiry"]}},"instructions":"Use only explicit inputs. Call calculate_financials. Do not perform mental arithmetic or issue the final decision.","tools":["calculate_financials"]},
    {"name":"scenario_simulator","function":{"description":"Runs dependency-driven Monte Carlo scenarios.","parameters":{"type":"object","properties":{"inquiry":{"type":"string"}},"required":["inquiry"]}},"instructions":"Call run_scenarios with explicit, labelled ranges. Do not invent probabilities.","tools":["run_scenarios"]},
    {"name":"dependency_intelligence","function":{"description":"Analyses cascading operational dependencies.","parameters":{"type":"object","properties":{"inquiry":{"type":"string"}},"required":["inquiry"]}},"instructions":"Construct a node-edge graph and call analyse_dependencies. Mark inferred links as hypotheses.","tools":["analyse_dependencies"]},
    {"name":"black_swan_red_team","function":{"description":"Creates plausible compound failure paths.","parameters":{"type":"object","properties":{"inquiry":{"type":"string"}},"required":["inquiry"]}},"instructions":"Provide trigger, transmission path, early warnings, mitigation, and HYPOTHETICAL or EVIDENCE_BASED classification. Avoid fantasy events.","tools":[]},
    {"name":"contrarian","function":{"description":"Attempts to falsify the emerging conclusion.","parameters":{"type":"object","properties":{"inquiry":{"type":"string"}},"required":["inquiry"]}},"instructions":"Challenge duplicated sources, stale data, unit errors, brittle assumptions, and hidden correlations. State reversal evidence.","tools":[]},
    {"name":"evidence_verifier","function":{"description":"Fails closed on unsupported claims.","parameters":{"type":"object","properties":{"inquiry":{"type":"string"}},"required":["inquiry"]}},"instructions":"Reject numeric claims without tool provenance and assumptions presented as facts. Return PASS or FAIL_CLOSED.","tools":[]},
    {"name":"committee","function":{"description":"Produces a conditional human decision memo.","parameters":{"type":"object","properties":{"inquiry":{"type":"string"}},"required":["inquiry"]}},"instructions":"Act only after verifier PASS. Return PROCEED, PROCEED_WITH_CONDITIONS, DEFER, or REJECT; include reversal conditions and require human approval.","tools":[]},
    {"name":"calculate_financials","function":{"description":"Calculate NPV, ROI and payback.","parameters":{"type":"object","properties":{"initial_investment":{"type":"float"},"cash_flows_json":{"type":"string"},"discount_rate":{"type":"float"}},"required":["initial_investment","cash_flows_json","discount_rate"]}},"class":"financial_model_tool.FinancialModelTool"},
    {"name":"run_scenarios","function":{"description":"Run reproducible Monte Carlo NPV scenarios.","parameters":{"type":"object","properties":{"base_case_json":{"type":"string"},"shocks_json":{"type":"string"},"iterations":{"type":"int"}},"required":["base_case_json","shocks_json"]}},"class":"scenario_tool.ScenarioTool"},
    {"name":"analyse_dependencies","function":{"description":"Identify critical graph nodes and cascading impact.","parameters":{"type":"object","properties":{"graph_json":{"type":"string"}},"required":["graph_json"]}},"class":"dependency_tool.DependencyTool"}
  ]
}
